# ==============================================================================
# AI Video Studio Environment Configuration Template
# Copy this file to .env and configure all necessary secrets.
# ==============================================================================

# Node Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/v1

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_video_studio
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Cloudflare R2 / AWS S3 Storage
STORAGE_PROVIDER=r2
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=replace_with_s3_or_r2_access_key
S3_SECRET_ACCESS_KEY=replace_with_s3_or_r2_secret_key
S3_BUCKET_NAME=ai-video-studio-assets
S3_REGION=auto
S3_PRESIGNED_READ_TTL_SEC=900
S3_PRESIGNED_UPLOAD_TTL_SEC=1800

# AI Foundation Model APIs
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
TAVILY_API_KEY=tvly-...

# Speech & TTS Services
ELEVENLABS_API_KEY=sk_...
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Stock Media Providers
PEXELS_API_KEY=replace_with_pexels_api_key
PIXABAY_API_KEY=replace_with_pixabay_api_key

# Generative Media Adapters
FAL_KEY=replace_with_fal_ai_key
COMFYUI_URL=http://localhost:8188

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...

# Render Engine Configuration
REMOTION_CONCURRENCY=1
REMOTION_CHROMIUM_FLAGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage
FFMPEG_PATH=C:\\Users\\ahiva\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-9.0.2-full_build\\bin\\ffmpeg.exe
FFPROBE_PATH=C:\\Users\\ahiva\\AppData\\Local\\Microsoft\\WinGet\\Packages\\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\\ffmpeg-9.0.2-full_build\\bin\\ffprobe.exe
